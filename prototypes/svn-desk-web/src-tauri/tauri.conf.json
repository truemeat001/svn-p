{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SVN Desk Web Preview",
  "version": "0.1.0",
  "identifier": "dev.svndesk.webpreview",
  "build": {"frontendDist": "../web"},
  "app": {
    "windows": [{"label": "main", "title": "SVN Desk · Web Preview (Demo)", "width": 1440, "height": 960, "minWidth": 760, "minHeight": 640}],
